

@model AccountRegisterViewModel


<div class="login-signup">

                        
    

    <div class="login-signup__container container">
                
        <div class="login-signup__signup">
            <form asp-action="Signup" asp-controller="User" method="post" class="signup">
                <div class="signup__name">
                    <input type="text" class="_input" name="Email" id="reg_email"  placeholder="smth@example.com" value="@Model?.Email">         
                </div>
                <div class="signup__email">
                    <input type="text" class="_input" name="PhoneNumber" id="reg_phonenumber"  value="@Model?.PhoneNumber" placeholder="333 333 333">       
                </div>
                <div class="signup__password">
                    <input type="text" class="_input" name="UserName" id="reg_username"  placeholder="Macik" value="@Model?.UserName">
                </div>
                <div class="signup__password">
                    <input type="password" class="_input" name="Password" id="reg_password"  placeholder="*************" >
                </div>
                <div class="signup__password">
                    <input type="password" class="_input" name="PasswordRepeat" id="reg_passwordrepeat"  placeholder="*************">
                </div>
                <div class="login__errors">
                    <span asp-validation-for="Email" class="text-danger"></span>
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    <span asp-validation-for="UserName" class="text-danger"></span>
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <span asp-validation-for="PasswordRepeat" class="text-danger"></span>
                    @ViewBag.ErrorText
                </div>
                <div class="signup__button">
                    <button type="submit" class="_button" name="register" value="Регистрация">Register</button>
                </div>
            </form>
            <div class="login__button">	
                <a href="/account/login" class="_button">Log in</a>
            </div>
        </div>
    </div>


</div>